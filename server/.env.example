# Required by the API at runtime. Use a MongoDB Atlas connection string for Vercel.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority

# Required by the API at runtime. Generate a unique random value; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Required for browser access in production. Use the frontend's origin, with no trailing slash/path.
CLIENT_URL=https://your-frontend.vercel.app

# Optional extra exact origins, comma-separated (for example a custom domain and a preview domain).
# Do not use * when credentials are enabled.
CLIENT_URLS=

# Optional. Vercel sets NODE_ENV=production for production deployments.
NODE_ENV=development

# Optional for local server.js only; Vercel supplies the serverless HTTP handling.
PORT=5000

# Optional JWT lifetime; defaults to 7d.
JWT_EXPIRES_IN=7d

# Optional; needed only when you run `npm run seed` to create the initial Head of HR account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
