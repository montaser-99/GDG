# ==========================================
# GDG Damanhour Evaluation API - Environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://ai-task:mw92wDgpYltNGcII@cluster0.e1dalzk.mongodb.net/?appName=Cluster0

# Random secret used to sign JWTs. Generate a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=nbdjghvhbjkmju378648793809eriufjhb

# Port the API server listens on
PORT=5000

# URL of the React client (used for CORS). Must match exactly the origin
# that the browser sends requests from.
CLIENT_URL=http://localhost:5173

# Optional: JWT lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Default Head HR account created by `npm run seed`
# The password must be at least 6 characters. It is hashed before saving.
SEED_ADMIN_EMAIL=mahmoudmontaser185@gmail.com
SEED_ADMIN_PASSWORD=Montaser123
# SEED_ADMIN_NAME=مسؤول الموارد البشرية

# Set to production in deployed environments (disables stack traces in errors,
# switches auth cookies to secure + SameSite=None)
# NODE_ENV=development
